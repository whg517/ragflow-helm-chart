{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "RAGFlow chart values",
  "type": "object",
  "properties": {
    "metadataDb": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mysql", "postgres", "oceanbase", "gaussdb"],
          "description": "Metadata backend. Source of truth: api/db/db_models.py PooledDatabase enum."
        },
        "host": { "type": "string" },
        "port": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string" }
          ],
          "description": "Leave empty for the type-appropriate default (mysql 3306, postgres/gaussdb 5432, oceanbase 2881)."
        },
        "user": { "type": "string" },
        "database": { "type": "string" }
      },
      "required": ["type"]
    },
    "docEngine": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["infinity", "elasticsearch", "opensearch"]
        }
      },
      "required": ["type"]
    },
    "storage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["minio", "s3", "oss", "azure", "gcs"]
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "existingSecret": { "type": "string" },
    "secretData": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "All values MUST be strings. Numeric-looking passwords are quoted by the template, but declaring them as strings here avoids surprises."
    },
    "api": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 }
      }
    },
    "executor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "workers": { "type": "integer", "minimum": 1 }
      }
    },
    "datasync": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "description": "Singleton by design; replica count is not configurable because sync_data_source.py holds no distributed lock."
    }
  }
}
